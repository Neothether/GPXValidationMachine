# Copy to .env and fill in. Never commit .env.

# TigerData (Tiger Cloud) service connection string, from the service's "Connect" panel.
DATABASE_URL=postgres://tsdbadmin:CHANGE_ME@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# One or more Gemini API keys, comma-separated. The wrapper rotates on rate limits.
GEMINI_API_KEYS=CHANGE_ME
# Check available IDs with:  python -m app.llm --list-models
GEMINI_MODEL_PRO=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-latest

# Password shared by the seeded demo signers (author, qa, owner, tester). Demo only.
DEMO_PASSWORD=change-me-demo

# Where executed-test evidence files are written.
EVIDENCE_DIR=./evidence
